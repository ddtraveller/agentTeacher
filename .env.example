# Copy to .env and adjust as needed.

# ── Ollama (the language model) ────────────────────────────────────────────
# Model tag. Smaller = faster on CPU.
# Options: qwen2.5:3b (default, fast, multilingual), qwen2.5:7b, qwen2.5:14b,
#          llama3.2:3b, gemma2:2b, phi3:mini
MODEL=qwen2.5:3b

# Generation knobs. Tune if replies feel either too short or too slow.
OLLAMA_NUM_PREDICT=180     # max tokens generated per reply
OLLAMA_NUM_CTX=1536        # context window (smaller = faster KV cache)
OLLAMA_TEMPERATURE=0.7     # 0 = deterministic, 1 = creative

# ── Whisper (speech-to-text) ───────────────────────────────────────────────
# tiny | base | small | medium | large-v3
# `small` is the sweet spot on CPU; bump to `medium` if you have GPU.
WHISPER_MODEL=small

# ── TTS (text-to-speech) ───────────────────────────────────────────────────
# cpu or cuda. The bundled Dockerfile installs CPU torch; switch to a CUDA
# wheel + nvidia base image if you want `cuda`.
TTS_DEVICE=cpu

# Edge TTS voices (online, Microsoft Neural). Used for English/Thai/Chinese
# by default — high quality, no model download.
EDGE_VOICE_EN=en-US-JennyNeural
EDGE_VOICE_TH=th-TH-PremwadeeNeural
EDGE_VOICE_ZH=zh-CN-XiaoxiaoNeural
# Set to 1 to route Chinese through Edge TTS (better quality, needs internet).
# Set to 0 to use local XTTS v2 for Chinese.
EDGE_FOR_ZH=0

# XTTS v2 built-in speaker — used for ja/ko (and zh-cn when EDGE_FOR_ZH=0),
# or when no `speaker_wav` is passed. Other options: Claribel Dervla,
# Daisy Studious, Sofia Hellen, ...
XTTS_SPEAKER=Ana Florence

# ── Wiki retrieval (RAG over your school's curriculum) ─────────────────────
# When true, Kru Eng grounds replies in the markdown under seed_wiki/.
# First start with RAG_ENABLED=true takes ~30s to build the index; cached
# after that. Adds ~50-150ms per reply.
RAG_ENABLED=false
EMBED_MODEL=nomic-embed-text
RAG_TOP_K=3
