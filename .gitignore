.env
.env.local
.env.*.local

# Per-machine docker-compose override (host-Ollama wiring, GPU stanzas, etc.)
# Each deployer has their own — don't commit it.
docker-compose.override.yml

# Voice reference clips — these are personal/identifying audio.
# The README.md in voices/ explains the format; clips themselves stay local.
voices/*.wav
voices/*.mp3
voices/*.flac

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker volume artifacts (if you ever bind-mount one of the named volumes)
wiki_index/
ollama_data/
tts_cache/

# Shared calendar events — per-deployment, written by the orchestrator.
# The data/calendar/ dir itself is kept (.gitkeep) so the bind-mount works.
data/calendar/shared_events.json
